# Set locally; never commit an actual API key.
ANTHROPIC_API_KEY=
# Choose the exact Sonnet model ID; LiteLLM format: anthropic/<model-id>
AGENT_MODEL=anthropic/claude-sonnet-5-5

# Embedding provider/model will be chosen before generating the saved vectors.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LANCEDB_PATH=data/index
SEMANTIC_TABLES_PATH=data/tables

SNOWFLAKE_ACCOUNT=DNPKSVD-ARC86250
SNOWFLAKE_USER=SAHILGARG5794
SNOWFLAKE_ROLE=CENSUS_READER
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=US_OPEN_CENSUS_DATA_NEIGHBORHOOD_INSIGHTS_FREE_DATASET
SNOWFLAKE_SCHEMA=PUBLIC
# Existing local exploration helper uses macOS Keychain, not a password here.
REQUEST_BUDGET_SECONDS=60
MAX_RESULT_ROWS=1000
MAX_SQL_RETRIES=2
TOPIC_TOKEN_LIMIT=12000
COVERAGE_THRESHOLD=0.9
SEMANTIC_DIR=definitions/generated
# Session persistence backend will be designed before deployment.
# Guardrails
GUARDRAIL_MODEL=anthropic/claude-haiku-4-5-20251001
GUARDRAIL_TIMEOUT_SECONDS=5
MAX_INPUT_CHARS=2000
GUARDRAIL_CONTEXT_TURNS=3
GLOSSARY_PATH=definitions/source/census_glossary.yaml
